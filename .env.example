# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# WhatsApp groep
GROUP_NAME=Squash Training
TRAINER_PHONE=31612345678

# Claude (interpreteren van poll-antwoorden)
ANTHROPIC_API_KEY=sk-ant-...
# Optioneel: standaard claude-haiku-4-5 (goedkoop/snel voor classificatie)
ANTHROPIC_MODEL=claude-haiku-4-5

# Planning
POLL_CRON=0 18 * * 1
TRAINING_DAY=thursday
TRAINING_TIME=20:00
SUMMARY_HOURS_BEFORE=2

# Web interface
PORT=8400

# bunq API (voor automatische betaalverzoeken)
# Hoe je deze vindt:
# 1. bunq app → Profiel → Beveiliging & instellingen → Developers → API keys → Add API key
# 2. Download de credentials
# 3. Je krijgt: API_KEY, USER_ID, MONETARY_ACCOUNT_ID
BUNQ_API_KEY=your_api_key_here
BUNQ_USER_ID=your_user_id_here
BUNQ_ACCOUNT_ID=your_monetary_account_id_here
# Environment: sandbox of production (production: https://api.bunq.com/v1)
BUNQ_ENVIRONMENT=sandbox
